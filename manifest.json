{
  "manifest_version": 3,
  "name": "StudyPulse",
  "version": "0.1.0",
  "description": "Measure real study, not screen time.",
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://coursology-qbank.com/qbanks/usmle1/tests/*"],
      "js": ["src/content/content.js"]
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html"
  }
}
